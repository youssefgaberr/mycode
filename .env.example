# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ── Required ────────────────────────────────────────────────────────────────
# CJdropshipping API key: CJ dashboard → My CJ → Authorization → API → API Key
CJ_API_KEY=
# Stripe secret key. Use a TEST key (sk_test_...) until you go live.
STRIPE_SECRET_KEY=
# Stripe publishable key (pk_test_...). Optional but recommended: shows the
# payment form ON your site (/checkout). Without it, customers are redirected
# to Stripe's hosted payment page instead.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe webhook signing secret (whsec_...). Locally: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Public URL of the site, no trailing slash (http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Password for /admin. Use a long random string.
ADMIN_PASSWORD=

# ── Database ────────────────────────────────────────────────────────────────
# SQLite file locally. Use a Postgres URL in production (see README).
DATABASE_URL=file:./prisma/dev.db

# ── Safety switch ───────────────────────────────────────────────────────────
# "test" (default): only Stripe test keys are accepted and CJ orders are
#   created as SANDBOX orders (no real charge, no real shipment).
# "live": real payments and real CJ orders. Only change when you're ready.
STORE_MODE=test

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Vercel sends this as a Bearer token to /api/cron/*. Any long random string.
CRON_SECRET=

# ── Email (optional) ────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are printed to the server log instead of sent.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend.
EMAIL_FROM="Brightpan <orders@your-domain.co.uk>"

# ── CJ (optional alternative) ───────────────────────────────────────────────
# Instead of CJ_API_KEY you can paste an access token you obtained yourself
# (valid 180 days). Leave empty to let the app manage tokens from CJ_API_KEY.
CJ_ACCESS_TOKEN=
